<?xml version="1.0" encoding="utf-8"?>
<!-- layer-list with only a color has intrinsic width/height = -1, which crashes
     PwaWrapperSplashScreenStrategy.convertDrawableToBitmap() on launch.
     A <shape> with <size> has explicit intrinsic dimensions. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/backgroundColor"/>
    <size android:width="320dp" android:height="640dp"/>
</shape>
